{
  "name": "guangmingding",
  "version": "0.1.0",
  "private": true,
  "description": "光明顶 - 多人同服文字经营游戏 v1 后端",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/main.js",
    "dev": "node --env-file=.env --watch --import tsx src/server/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:prod": "node dist/db/seed.js",
    "settle": "node --env-file=.env --import tsx src/game/settle-cli.ts",
    "bench:settle": "node --env-file=.env --import tsx src/game/bench.ts",
    "db:reset": "node --env-file=.env --import tsx src/db/reset.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
