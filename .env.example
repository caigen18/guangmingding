# 光明顶 v1 本地开发环境变量示例（cp .env.example .env 后用）
# 不要提交真实密钥；.env 已在 .gitignore 里。

# Postgres 16 连接串。本机 openming 上开发库由 /root/gmd/docker-compose.dev.yml 管，
# 宿主只绑 127.0.0.1:55432（容器内仍是 db:5432，app 容器里由 compose 覆盖成 db:5432）。
DATABASE_URL=postgres://gmd:gmd_dev_pw@127.0.0.1:55432/gmd

# HTTP + WebSocket 同源端口。本机 3000/3001 被 agentes 聊天服务占着，直接 npm run dev 用 3002；
# 容器里由 compose 固定 PORT=3000，宿主映射到 127.0.0.1:3002。
PORT=3002

NODE_ENV=development
TZ=Asia/Shanghai

# 赛季长度（游戏日 = 现实一日）。按 #1/#4：第 10 日结算，赛季 10 日。
SEASON_DAYS=10

# AI 事件生成（可选）。空着就走模板兜底，不花钱。
AI_API_KEY=
AI_MODEL=
AI_AUTO_PUBLISH=false

# /admin/* Basic Auth
ADMIN_USER=admin
ADMIN_PASS=change-me
